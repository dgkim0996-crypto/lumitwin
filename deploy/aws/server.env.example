# LumiTwin 배포 서버용 server/.env 예시. setup-ubuntu.sh 가 복사하고 DB 주소·도메인을 채운다.
# 이 파일(server/.env)은 git에 올리지 않는다. 권한은 600으로 둔다.

NODE_ENV=production

# ── DB (시스템 PostgreSQL. setup-ubuntu.sh 가 사용자·비밀번호를 만들어 채운다) ──
DATABASE_URL=postgresql://lumitwin:CHANGE_ME@127.0.0.1:5432/lumitwin
# EMBEDDED_DB=1 로 띄울 때는 대신 이 주소
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/lumitwin

# ── 받는 주소: 같은 서버의 Caddy·시뮬레이터만 붙게 127.0.0.1 ──
API_HOST=127.0.0.1
API_PORT=8790
MQTT_BIND=127.0.0.1
MQTT_PORT=1884
CORS_ORIGIN=https://lumitwin.example.com

# ── 보기 전용: 서버 전체가 공개되므로 모든 방문자를 보기 전용으로 둔다 ──
# 시연자는 화면의 "보기 전용"을 눌러 CONTROL_KEY를 넣으면 조작할 수 있다. setup-ubuntu.sh 가 키를 만들어 채운다
READ_ONLY=all
CONTROL_KEY=CHANGE_ME

# ── AI 현장 비서 ──
# 키가 없으면 모의 모드(규칙 기반, 같은 도구로 실제 데이터 조회)로 돈다. 비용이 들지 않는다
ASSISTANT_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# 공개 링크에서 Claude API 비용이 새지 않게 질문 수를 막는다 (Claude 모드에서만 센다, 0 = 제한 없음)
ASSISTANT_MAX_PER_HOUR=20
ASSISTANT_MAX_PER_DAY=300

# ── 음성 질문 ──
# WHISPER=1 로 받아쓰기 서버를 띄웠을 때만 켠다. 없으면 브라우저 음성 인식(Chrome·Edge)으로 대신한다
# STT_BASE_URL=http://127.0.0.1:8792
# STT_MODEL=small
