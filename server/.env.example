# LumiTwin MES 서버 환경 변수 예시. 복사해서 server/.env 로 쓴다 (.env는 git에 올라가지 않는다)
# 아무것도 설정하지 않아도 로컬 DB·모의 모드 AI 비서로 돌아간다.

# ── DB (기본: npm run dev가 띄우는 embedded-postgres) ──
# DATABASE_URL=postgresql://postgres:postgres@localhost:54332/lumitwin

# ── API ──
# API_PORT=8790
# 받는 주소. 비우면 모든 주소(같은 망의 태블릿에서 http://<PC IP>:5180 으로 들어올 때 필요). 배포 서버는 127.0.0.1
# API_HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:5180
# MQTT 브로커 포트·받는 주소 (시뮬레이터가 붙는 곳)
# MQTT_PORT=1884
# MQTT_BIND=127.0.0.1

# ── 공개 링크 보기 전용 (deploy/cloudflare/README.md) ──
# tunnel(기본): Cloudflare를 거쳐 온 요청(Cloudflare Tunnel 공개 링크)만 보기 전용 · all: 모든 요청 · off: 끔
# READ_ONLY=tunnel
# 이 키를 넣은 화면은 보기 전용이어도 조작할 수 있다 (화면의 "보기 전용"을 눌러 입력). 비우면 풀 수 없다
# CONTROL_KEY=

# ── AI 현장 비서 ──
# auto(기본): ANTHROPIC_API_KEY가 있으면 Claude, 없으면 모의 모드(규칙 기반, 같은 도구로 실제 데이터 조회)
# ASSISTANT_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# 생각 깊이: low · medium · high · xhigh · max (높을수록 느리고 비싸다)
# ASSISTANT_EFFORT=medium
# 공개 링크용 질문 한도 (Claude 모드에서만 센다, 비우거나 0 = 제한 없음): IP별 시간당 · 서버 전체 하루(한국 날짜)
# ASSISTANT_MAX_PER_HOUR=20
# ASSISTANT_MAX_PER_DAY=300

# ── 음성 질의 (OpenAI 호환 /v1/audio/transcriptions) ──
# 비워 두거나 그 서버가 꺼져 있으면 화면이 브라우저 음성 인식(Web Speech API)으로 대신한다 (30초마다 다시 확인)
# 로컬 faster-whisper: npm run whisper:setup 한 번 → npm run whisper (tools/whisper, 처음 실행 때 small 모델 약 460MB 내려받음)
#   모델·장치는 그 프로세스의 WHISPER_MODEL(tiny·base·small·medium·large-v3·turbo), WHISPER_DEVICE(cpu·cuda)로 바꾼다
# STT_BASE_URL=http://localhost:8792
# STT_MODEL=small
# 클라우드 서비스를 쓸 때만
# STT_API_KEY=
